{
  "name": "dutch-blitz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "server": "tsx watch server/index.ts",
    "start": "concurrently \"npm run dev\" \"npm run server\"",
    "build": "vite build",
    "build:start": "npm run build && NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.11.14",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
