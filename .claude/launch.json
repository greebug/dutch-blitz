{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "blitz",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "gin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:gin",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "gin-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "server"
      ],
      "port": 3001
    }
  ]
}
